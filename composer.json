{
    "name": "clementdecou/simply-mvc",
    "description": "Simply Framework extension to add the availability using MVC pattern in WordPress",
    "type": "wordpress-muplugin",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Simply\\Mvc\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Simply\\Mvc\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.2",
        "clementdecou/simply-framework": "^0.3",
        "clementdecou/simply-maker": "^0.4",
        "symfony/config": "^7.4",
        "symfony/console": "^7.4",
        "symfony/dependency-injection": "^7.4",
        "symfony/http-foundation": "^7.4",
        "symfony/http-kernel": "^7.4",
        "symfony/service-contracts": "^3.0"
    },
    "require-dev": {
        "brain/monkey": "^2.6",
        "phpstan/phpstan": "^1.10",
        "phpunit/phpunit": "^11.5",
        "szepeviktor/phpstan-wordpress": "^1.3"
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G --no-progress"
    }
}
